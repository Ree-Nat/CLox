fun vector(x, y){
    fun getX()
    {
        return xValue;
    }
    fun getY()
    {
        return yValue;
    }

    fun add(vec){
        return vector(x + other("x), y + other("y"))
    }

    fun dispatch(message){
        if (message == "x") return getX();
        if (message == "y) return getY();
        if (message == "add) return add;
        print "unknown message";
        return nil;
    }
    return dispatch

}

var a = vector(1,1);
